---
import { u } from '@/lib/url';
import '@/styles/global.css';
import { getCourses } from '@/lib/learn';
import { published } from '@/lib/content';
import { getResearch } from '@/lib/research';
const hasLearn = (await getCourses()).length > 0;
const hasResearch = (await getResearch()).length > 0;
const hasMoments = (await published('moments')).length > 0;
const { title, noindex, wide, math, description = 'Harshit Mishra, applied research scientist in France.' } = Astro.props;
const here = Astro.url.pathname, path = here.slice(u('').length);
const full = title ? `${title} / Harshit Mishra` : 'Harshit Mishra';
const img = new URL(u('/me.jpg'), Astro.site).href;
const nav = [['Notes', '/notes/'], ['Writing', '/writing/'], ['Learn', '/learn/'], ['Research', '/research/'], ['Moments', '/moments/']].filter(([l]) => (l !== 'Research' || hasResearch) && (l !== 'Learn' || hasLearn) && (l !== 'Moments' || hasMoments));
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
  <script is:inline>try{const t=localStorage.theme;if(t)document.documentElement.dataset.theme=t}catch{}</script>
  <title>{full}</title><meta name="description" content={description} />
  {noindex && <meta name="robots" content="noindex" />}
  <link rel="canonical" href={new URL(here, Astro.site).href} />
  <link rel="alternate" type="application/rss+xml" title="Writing" href={u("/rss.xml")} />
  <link rel="icon" type="image/jpeg" href={u("/me.jpg")} />
  <meta property="og:title" content={full} /><meta property="og:description" content={description} />
  <meta property="og:image" content={img} /><meta name="twitter:card" content="summary" />
  {math && <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.css" />}
  <link rel="preconnect" href="https://fonts.googleapis.com" /><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=DM+Mono&family=Inter+Tight:wght@400;500;600&family=Fraunces:ital,opsz,wght@0,9..144,400..600;1,9..144,400..600&display=swap" rel="stylesheet" />
</head>
<body data-base={u('')}>
  <div class={`page${wide ? ' wide' : ''}`}>
    <header class="bar mono">
      <a href={u("/")} class="brand"><i class="blk"></i>H. Mishra</a>
      <nav>
        {nav.map(([l, h]) => <a href={u(h)} aria-current={path.startsWith(h) ? 'page' : undefined}>{l}</a>)}
        <a href={u("/#contact")}>Contact</a>
        <button id="sb" aria-label="Search" title="Search ( / )">⌕</button><button id="tg" aria-label="Toggle theme" title="Light / dark">◐</button>
      </nav>
    </header>
    <slot />
    <footer class="mono dim"><span>© {new Date().getFullYear()} Harshit Mishra</span><span><a href={u("/archive/")}>Archive</a> · <a href={u("/tags/")}>Tags</a> · <a href={u("/rss.xml")}>RSS</a></span></footer>
  </div>
  <dialog id="sd"><input id="sq" placeholder="Search posts, notes, topics…" autocomplete="off" /><div id="sr"></div></dialog>
<script is:inline>
(() => {
  const $ = i => document.getElementById(i), R = document.documentElement;
  $('tg').onclick = () => { const d = (R.dataset.theme || (matchMedia('(prefers-color-scheme:dark)').matches ? 'dark' : 'light')) === 'dark'; R.dataset.theme = d ? 'light' : 'dark'; try { localStorage.theme = R.dataset.theme; } catch {} };
  document.querySelectorAll('.prose pre').forEach(p => { if (p.dataset.language === 'mermaid') return; const t = p.textContent, b = document.createElement('button'); b.className = 'cp'; b.textContent = 'copy';
    b.onclick = () => navigator.clipboard.writeText(t).then(() => { b.textContent = 'copied ✓'; setTimeout(() => b.textContent = 'copy', 1500); }); p.append(b); });
  const L = [...document.querySelectorAll('.toc-side a')], H = L.map(a => document.getElementById(decodeURIComponent(a.hash.slice(1)))).filter(Boolean);
  if (H.length) { const io = new IntersectionObserver(es => es.forEach(e => e.isIntersecting && L.forEach(a => a.classList.toggle('on', decodeURIComponent(a.hash) === '#' + e.target.id))), { rootMargin: '-80px 0px -70% 0px' }); H.forEach(h => io.observe(h)); }
  const sn = $('sn'); if (sn && innerWidth < 1100) sn.open = false;
  const mm = [...document.querySelectorAll('pre[data-language=mermaid]')];
  if (mm.length) import('https://cdn.jsdelivr.net/npm/mermaid@11.4.1/dist/mermaid.esm.min.mjs').then(({ default: m }) => {
    m.initialize({ startOnLoad: false, theme: (R.dataset.theme || (matchMedia('(prefers-color-scheme:dark)').matches ? 'dark' : 'light')) === 'dark' ? 'dark' : 'default' });
    mm.forEach(async (p, i) => { const d = document.createElement('div'); d.className = 'mermaid'; d.innerHTML = (await m.render('mm' + i, p.textContent)).svg; p.replaceWith(d); }); });
  document.querySelectorAll('[data-copy]').forEach(b => b.onclick = () => navigator.clipboard.writeText(b.dataset.copy).then(() => { const t = b.textContent; b.textContent = 'Copied'; setTimeout(() => b.textContent = t, 1500); }));
  let DB = null; const sd = $('sd'), sq = $('sq'), sr = $('sr');
  const open = async () => { sd.showModal(); sq.focus(); if (!DB) DB = await fetch(document.body.dataset.base + '/search.json').then(r => r.json()); };
  $('sb').onclick = open; sd.onclick = e => { if (e.target === sd) sd.close(); };
  addEventListener('keydown', e => { if (e.key === '/' && !/INPUT|TEXTAREA/.test(document.activeElement.tagName)) { e.preventDefault(); open(); } });
  sq.oninput = () => { const w = sq.value.toLowerCase().split(/\s+/).filter(Boolean); sr.textContent = ''; if (!w.length || !DB) return;
    DB.filter(d => w.every(x => (d.t + ' ' + d.g + ' ' + d.x).toLowerCase().includes(x))).slice(0, 8).forEach(d => {
      const a = document.createElement('a'), b = document.createElement('b'), s = document.createElement('small'), i = Math.max(0, d.x.toLowerCase().indexOf(w[0]));
      a.href = d.u; b.textContent = d.t; s.textContent = d.k + ' · ' + d.x.slice(Math.max(0, i - 30), i + 90); a.append(b, s); sr.append(a); }); };
})();
</script>
</body>
</html>
